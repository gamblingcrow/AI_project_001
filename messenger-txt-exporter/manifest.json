{
  "manifest_version": 3,
  "name": "Messenger Chat to TXT",
  "version": "1.0.0",
  "description": "Export the open Facebook Messenger conversation to a plain .txt file.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://www.messenger.com/*",
    "https://www.facebook.com/*",
    "https://web.facebook.com/*"
  ],
  "action": {
    "default_title": "Export Messenger chat to TXT",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
